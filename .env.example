# Copier ce fichier en .env et l'adapter. Le fichier .env n'est jamais versionné.

# Source des données : PostgreSQL (jour du hackathon)...
# BONDALORIANS_DSN=host=localhost port=5432 dbname=bonds user=lecteur password=...
# ...ou un fichier CSV au schéma canonique. Sans l'un ni l'autre, les données
# synthétiques de data/synthetic_bonds.csv sont utilisées.
# BONDALORIANS_CSV=data/synthetic_bonds.csv

# 0 pour couper CatBoost (démarrage en 5 secondes au lieu d'une minute).
BONDALORIANS_USE_ML=1

# Port de l'interface. 8551 par défaut, pour ne pas entrer en conflit avec une autre
# application Streamlit (port 8501 par défaut).
BONDALORIANS_PORT=8551
